# ─────────────────────────────────────────────────────────────
# Solvia · variables de entorno de ejemplo
# Copia este archivo a `.env` (ignorado por Git) y ajusta los valores.
# NUNCA pongas claves reales en este archivo.
# ─────────────────────────────────────────────────────────────

# ── Entorno ──
# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── PostgreSQL (docker-compose) ──
POSTGRES_USER=solvia
POSTGRES_PASSWORD=solvia
POSTGRES_DB=solvia
POSTGRES_PORT=5432

# ── Base de datos (API ejecutándose fuera de Docker) ──
# Dentro de docker-compose se sobrescribe para apuntar al servicio `postgres`.
DATABASE_URL=postgresql+asyncpg://solvia:solvia@localhost:5432/solvia
DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# ── API ──
API_PORT=8000
# Orígenes permitidos (JSON): Vite en desarrollo y el webview de Tauri.
CORS_ORIGINS=["http://localhost:1420","tauri://localhost","http://tauri.localhost"]

# ── Seguridad ──
# En producción la API no arranca con el valor de ejemplo ni con menos de 32 caracteres.
# Genera uno con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-solvia-development-only-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# ── Inicio de sesión ──
# Intentos fallidos permitidos por email+IP dentro de la ventana (en segundos).
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# ── Organización ──
# Nombre que la app de escritorio muestra en el login. Vacío: no se muestra nada.
ORGANIZATION_NAME=
# Zona horaria IANA con la que se agrupan los días del panel y los filtros por fecha.
# La base de datos guarda siempre UTC.
ORGANIZATION_TIMEZONE=America/Bogota

# ── Alertas ──
# Job que evalúa SLA, alertas y cuellos de botella dentro de la API.
# Con varias réplicas solo una ejecuta cada ronda (lock consultivo de Postgres).
ALERTS_JOB_ENABLED=true
ALERTS_JOB_INTERVAL_MINUTES=15
# Cantidad mínima de solicitudes en un área y etapa para marcar un cuello de botella por
# cantidad (además de superar 1,5 veces la mediana de 30 días). El criterio de horas
# promedio sobre el SLA no tiene mínimo.
BOTTLENECK_MIN_COUNT=3

# ── Datos semilla (python -m app.scripts.seed) ──
# Admin inicial. La contraseña debe tener al menos 12 caracteres; ponla solo en tu `.env`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_PASSWORD=
# Solo con ENVIRONMENT=development: contraseña de los usuarios de demo
# (supervisor@example.com, responsable1@example.com y responsable2@example.com).
SEED_DEMO_PASSWORD=

# ── IA ──
# none | deepseek
AI_PROVIDER=none
# Obligatoria si AI_PROVIDER=deepseek. Pégala solo en tu `.env`.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOKENS=1024
# Análisis global (diario o bajo demanda): modelo con razonamiento.
DEEPSEEK_MODEL_DEEP=deepseek-v4-pro
# low | high | max
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_DEEP_TIMEOUT_SECONDS=120
DEEPSEEK_DEEP_MAX_TOKENS=16000
# Si es true, el título y la descripción de la solicitud se envían a la IA, delimitados como
# contenido del usuario. Por defecto solo se envían códigos, áreas, estados y métricas.
AI_SEND_REQUEST_TEXT=false
# Tokens diarios (en la zona horaria de la organización); al superarlos se usa el análisis
# por reglas hasta el día siguiente.
AI_DAILY_TOKEN_BUDGET=200000
# Análisis bajo demanda por usuario y hora.
AI_USER_HOURLY_LIMIT=10
# Interruptor de los análisis automáticos (diario global y solicitudes de alto riesgo).
AI_AUTOMATIC_ENABLED=true
AI_AUTOMATIC_MAX_PER_RUN=10
AI_CACHE_HOURS=6
# Idioma de los análisis programados: es | en
ORGANIZATION_LANGUAGE=es
